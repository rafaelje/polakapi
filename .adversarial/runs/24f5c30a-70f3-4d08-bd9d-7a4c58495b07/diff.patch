+        {
+            let child = Command::new("ghostty")
+                .arg(format!("--working-directory={path}"))
+                .spawn()
+                .map_err(|e| format!("failed to launch ghostty: {e}"))?;
+            map.insert(canonical, child);
+        }
+        #[cfg(windows)]
+        {
+            let _ = path;
+            return Err("ghostty is not available on Windows".to_string());
+        }
+        Ok(())
+    }
