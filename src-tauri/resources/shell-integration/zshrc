# polakapi shell integration wrapper. Sourced as $ZDOTDIR/.zshrc because the
# app overrides ZDOTDIR when spawning a bare zsh terminal (materialized here
# as ".zshrc", never touching the user's real dotfiles). Restores ZDOTDIR to
# its original value (or unsets it) BEFORE sourcing the user's real .zshrc,
# so anything in their config that itself depends on ZDOTDIR behaves exactly
# as it would outside the app — then adds the command-capture hook after.

_polakapi_integration_dir="$ZDOTDIR"

if [ -n "$POLAKAPI_REAL_ZDOTDIR" ]; then
  ZDOTDIR="$POLAKAPI_REAL_ZDOTDIR"
else
  unset ZDOTDIR
fi

if [ -n "$ZDOTDIR" ] && [ -f "$ZDOTDIR/.zshrc" ]; then
  source "$ZDOTDIR/.zshrc"
elif [ -z "$ZDOTDIR" ] && [ -f "$HOME/.zshrc" ]; then
  source "$HOME/.zshrc"
fi

source "$_polakapi_integration_dir/integration.zsh"
unset _polakapi_integration_dir POLAKAPI_REAL_ZDOTDIR
